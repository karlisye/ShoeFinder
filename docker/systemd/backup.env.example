# Copy this file to /etc/shoe-finder/backup.env and restrict it to root.
BACKUP_COMPOSE_FILE=/opt/shoe-finder/compose.production.yaml
BACKUP_ENV_FILE=/opt/shoe-finder/.env.production
BACKUP_OUTPUT_DIR=/var/backups/shoe-finder

BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_INCLUDE_FEEDS=false

# Optional rclone destination. Keep rclone credentials outside this repository.
# Example: hetzner:shoe-finder-backups/production
BACKUP_RCLONE_REMOTE=
