{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shoefinder.example/retailer-product-feed.json",
  "title": "Retailer product feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["retailer", "generated_at", "products"],
  "properties": {
    "retailer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "jsonl-feed.schema.json"
      }
    }
  }
}
