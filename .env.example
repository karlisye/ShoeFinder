COMPOSE_PROJECT_NAME=shoe_finder
APP_PORT=8080
ADMINER_PORT=8081

# Replace with the final HTTPS public origin in production.
APP_URL=http://localhost:8080

POSTGRES_DB=shoe_finder
POSTGRES_USER=shoe_finder
POSTGRES_PASSWORD=shoe_finder
OFFER_STALE_AFTER_HOURS=168
REDIS_QUEUE_RETRY_AFTER=360
FEED_IMPORT_QUEUE=imports

# Required for production. Generate with:
# docker compose run --rm backend-php php artisan key:generate --show
APP_KEY=
FILAMENT_ADMIN_EMAIL=
